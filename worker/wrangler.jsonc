{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scm820-iwa",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker first so it can set headers (CORS, cache) on update.json and the bundles.
    "run_worker_first": true
  }
}
